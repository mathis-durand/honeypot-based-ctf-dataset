4f4e4f5a-d6c3-4609-a321-e9a486dbd4b5;4;2025-10-21 23:35:14;-1;# 1) Récupérer la ligne de route par défaut
4f4e4f5a-d6c3-4609-a321-e9a486dbd4b5;4;2025-10-21 23:35:14;-1;read IFACE DEST GATEWAY MASK _ < <(awk '$2=="00000000" {print $1,$2,$3,$8; exit}' /proc/net/route)
4f4e4f5a-d6c3-4609-a321-e9a486dbd4b5;4;2025-10-21 23:35:14;-1;# 2) Petite fonction pour passer HEX -> IPv4
4f4e4f5a-d6c3-4609-a321-e9a486dbd4b5;4;2025-10-21 23:35:14;-1;hex2ip(){ printf "%d.%d.%d.%d\n" "0x${1:6:2}" "0x${1:4:2}" "0x${1:2:2}" "0x${1:0:2}"; }
4f4e4f5a-d6c3-4609-a321-e9a486dbd4b5;4;2025-10-21 23:35:14;-1;GW_IP=$(hex2ip "$GATEWAY")
4f4e4f5a-d6c3-4609-a321-e9a486dbd4b5;4;2025-10-21 23:35:14;-1;MASK_IP=$(hex2ip "$(printf '%08x\n' "$MASK")")
4f4e4f5a-d6c3-4609-a321-e9a486dbd4b5;4;2025-10-21 23:35:14;-1;echo "IFACE=$IFACE  GW=$GW_IP  MASK=$MASK_IP"
4f4e4f5a-d6c3-4609-a321-e9a486dbd4b5;4;2025-10-21 23:35:14;-1;# 3) On prend le /24 du gateway (suffisant dans 99% des labs)
4f4e4f5a-d6c3-4609-a321-e9a486dbd4b5;4;2025-10-21 23:35:14;-1;NET_PREFIX=$(echo "$GW_IP" | cut -d. -f1-3)
4f4e4f5a-d6c3-4609-a321-e9a486dbd4b5;4;2025-10-21 23:35:14;-1;echo "NET_PREFIX=$NET_PREFIX"
